# DivyaImpex credentials - copy this file to "e2e/DivyaImpex/.env" and fill in real values.
# ".env" is gitignored and must never be committed.
DIVYAIMPEX_URL=https://staging-fc.cargowayz.net/login/DIVYAIMPEX
DIVYAIMPEX_USERNAME=
DIVYAIMPEX_PASSWORD=
DIVYAIMPEX_BRANCH=Metro Freight Terminal

# Number of cargo records added to the enquiry (default 10).
DIVYAIMPEX_CARGO_COUNT=10

# Optional fixed Reference Invoice No for Generate Job (default: unique QAINV<digits> per run).
DIVYAIMPEX_REFERENCE_INVOICE_NO=

# Optional Playwright overrides: HEADLESS=true|false, VIDEO=on|off|retain-on-failure, SLOW_MO=<ms>
